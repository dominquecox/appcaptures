{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appcaptures",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [],
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
